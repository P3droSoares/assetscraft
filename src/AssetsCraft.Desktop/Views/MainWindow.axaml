<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetsCraft.Desktop.ViewModels"
        xmlns:views="using:AssetsCraft.Desktop.Views"
        xmlns:core="using:AssetsCraft.Core.Projects"
        x:Class="AssetsCraft.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AssetsCraft"
        Icon="avares://AssetsCraft/Assets/icon.png"
        Width="1440" Height="880" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="260,*">
    <!-- ======================= sidebar ======================= -->
    <Border Grid.Column="0" Background="{StaticResource Carbon}" BorderBrush="{StaticResource Graphite}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- logo -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,18,16,20">
          <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource Paper}">
            <Path Data="M 4 4 h 5 v 5 h -5 z M 11 4 h 5 v 5 h -5 z M 4 11 h 5 v 5 h -5 z M 13 13 h 3 v 3 h -3 z" Fill="{StaticResource Void}" />
          </Border>
          <TextBlock Classes="logo" Text="AssetsCraft" VerticalAlignment="Center" />
        </StackPanel>

        <!-- linked game project -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="12,0,12,14">
          <TextBlock Classes="label-strong" Text="Projeto do jogo" Margin="6,0,0,0" />
          <Button x:Name="GameButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8"
                  ToolTip.Tip="{Binding GameInfo}">
            <DockPanel>
              <Path DockPanel.Dock="Right" Width="8" Height="5" Stretch="Uniform" Stroke="{StaticResource Fog}" StrokeThickness="1.3"
                    Data="M0,0 L4,4 L8,0" VerticalAlignment="Center" Margin="8,0,0,0" />
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding GameName}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Paper}" />
                <TextBlock Classes="mono faint" FontSize="10" Text="{Binding GameInfo}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding HasGame}" />
                <TextBlock Classes="faint" FontSize="11" Text="clique para vincular" IsVisible="{Binding HasNoGame}" />
              </StackPanel>
            </DockPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="picker">
                <StackPanel Spacing="2" Width="280">
                  <ItemsControl ItemsSource="{Binding Games}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:GameProject">
                        <Button Classes="pick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnGamePicked">
                          <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Mist}" />
                            <TextBlock Classes="mono" Text="{Binding Path}" FontSize="10" Foreground="{StaticResource Ash}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator Margin="0,4" />
                  <Button Classes="pick" HorizontalAlignment="Stretch" Content="Vincular projeto…" Click="OnLinkGame" />
                  <Button Classes="pick" HorizontalAlignment="Stretch" Content="Desvincular este projeto" Click="OnUnlinkGame"
                          IsVisible="{Binding HasGame}" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>

        <!-- one button to start anything: the type is chosen here, not by switching sections -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12,0,12,16">
          <Button x:Name="NewButton" Classes="pill-white" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  IsEnabled="{Binding HasGame}" ToolTip.Tip="Escolha o tipo; o nome sai do seu primeiro pedido">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="+" FontSize="15" Margin="0,-2,0,0" />
              <TextBlock Text="Novo asset" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="picker">
                <ItemsControl ItemsSource="{Binding NewChoices}" Width="260">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewAssetChoice">
                      <Button Classes="pick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsEnabled="{Binding IsAvailable}" Click="OnNewPicked">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Mist}" />
                          <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{StaticResource Ash}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Classes="notice" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock FontSize="12" Foreground="{StaticResource Mist}" Text="{Binding Error}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <!-- ============ usage limits ============ -->
        <Border DockPanel.Dock="Bottom" Classes="hairline-t" Padding="16,12,12,14">
          <StackPanel Spacing="10" DataContext="{Binding Usage}" x:DataType="vm:UsageViewModel">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="text" Padding="4,0" Command="{Binding RefreshCommand}"
                      ToolTip.Tip="Atualizar limites (não consome uso)">
                <Panel>
                  <TextBlock Text="↻" FontSize="13" Foreground="{StaticResource Fog}" IsVisible="{Binding !IsRefreshing}" />
                  <Arc Classes="spinner" Width="10" Height="10" IsVisible="{Binding IsRefreshing}" />
                </Panel>
              </Button>
              <TextBlock Classes="label-strong" Text="Uso do Claude" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:UsageRow">
                  <StackPanel Spacing="4" Margin="0,0,0,10">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Classes="mono usage-pct" FontSize="11" Text="{Binding PercentText}"
                                 Classes.hot="{Binding IsHigh}" />
                      <TextBlock FontSize="12" Text="{Binding Label}" Foreground="{StaticResource Mist}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Classes="usage" Classes.hot="{Binding IsHigh}" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                    <TextBlock Classes="faint" FontSize="11" Text="{Binding ResetText}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap" Text="Lendo limites…"
                       IsVisible="{Binding !HasRows}" />
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{Binding Error}"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="faint" FontSize="10" Text="{Binding UpdatedText}" Margin="0,-6,0,0" />
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="hairline-t" Padding="16,10" IsVisible="{Binding IsDeleting}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Arc Classes="spinner" />
            <TextBlock Classes="muted" FontSize="12" Text="Excluindo asset…" />
          </StackPanel>
        </Border>

        <!-- assets of the game: one row per sprite/tileset, with how far along it is -->
        <DockPanel DockPanel.Dock="Top" Margin="18,0,16,6" IsVisible="{Binding HasAssets}">
          <TextBlock DockPanel.Dock="Right" Classes="mono faint" FontSize="10" Text="{Binding TotalSizeText}"
                     ToolTip.Tip="Espaço ocupado pelos assets deste projeto" />
          <TextBlock Classes="label-strong" Text="Assets do jogo" />
        </DockPanel>
        <ListBox Classes="nav" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" Margin="8,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssetItem">
              <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                <Border Classes="thumb" Margin="0,0,10,0" VerticalAlignment="Center">
                  <Panel>
                    <views:SpriteCanvas Sheet="{Binding Thumb}" Animation="{Binding ThumbAnimation}" IsPlaying="False"
                                        Backdrop="escuro" IsVisible="{Binding HasThumb}" IsHitTestVisible="False" />
                    <TextBlock Text="?" Classes="faint" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasThumb}" />
                  </Panel>
                </Border>

                <Button Grid.Column="2" Classes="text row-action" Padding="6,4" VerticalAlignment="Center"
                        ToolTip.Tip="Opções do asset">
                  <StackPanel Orientation="Horizontal" Spacing="2.5">
                    <Ellipse Width="3" Height="3" Fill="{StaticResource Fog}" />
                    <Ellipse Width="3" Height="3" Fill="{StaticResource Fog}" />
                    <Ellipse Width="3" Height="3" Fill="{StaticResource Fog}" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                      <MenuItem Header="Renomear" Command="{Binding RenameCommand}" />
                      <Separator />
                      <MenuItem Header="Excluir asset…" Command="{Binding DeleteCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="item-title" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"
                             IsVisible="{Binding !IsRenaming}" />
                  <TextBox Classes="rename" Text="{Binding EditName}" IsVisible="{Binding IsRenaming}"
                           FontSize="13" Padding="6,3" MinHeight="0" Margin="-7,-4,0,-1"
                           KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Classes="sent-dot" IsVisible="{Binding IsSent}" ToolTip.Tip="Já está no projeto do jogo" />
                    <TextBlock Classes="faint" FontSize="11" Text="{Binding KindLabel}" />
                    <TextBlock Classes="faint" FontSize="11" Text="·" />
                    <TextBlock Classes="faint" FontSize="11" Text="{Binding StepText}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ======================= content ======================= -->
    <Panel Grid.Column="1">
      <!-- 1st run: the whole flow at a glance, starting with the only thing needed -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="22" MaxWidth="520"
                  IsVisible="{Binding HasNoGame}">
        <StackPanel Spacing="8">
          <TextBlock Classes="heading" Text="Crie os assets do seu jogo conversando" />
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Você descreve, o Claude desenha pixel a pixel e o PNG vai direto para a pasta do jogo. O caminho é sempre o mesmo:" />
        </StackPanel>
        <StackPanel Spacing="14">
          <DockPanel>
            <Border Classes="num" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="1" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="Vincule o projeto do jogo" Foreground="{StaticResource Paper}" />
              <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" Text="A pasta do jogo, por exemplo a do .csproj MonoGame. O app só copia PNGs para Content/." />
            </StackPanel>
          </DockPanel>
          <DockPanel>
            <Border Classes="num" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="2" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="Descreva e refine" Foreground="{StaticResource Mist}" />
              <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" Text="Cada ajuste vira uma nova versão; as antigas continuam salvas." />
            </StackPanel>
          </DockPanel>
          <DockPanel>
            <Border Classes="num" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="3" /></Border>
            <StackPanel Spacing="2">
              <TextBlock Text="Anime e envie ao jogo" Foreground="{StaticResource Mist}" />
              <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" Text="Gostou de uma versão? Anime ali mesmo e envie com um clique." />
            </StackPanel>
          </DockPanel>
        </StackPanel>
        <Button Classes="primary" Content="Vincular projeto do jogo…" HorizontalAlignment="Left" Command="{Binding LinkGameCommand}" />
      </StackPanel>

      <!-- game linked, nothing created yet -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18" IsVisible="{Binding ShowWelcome}">
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <TextBlock Classes="heading" Text="O que vamos criar?" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding GameName, StringFormat='Para {0}. Você pode criar outros depois pelo “+ Novo asset”.'}"
                     HorizontalAlignment="Center" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding NewChoices}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NewAssetChoice">
              <Button Classes="choice" Margin="6" IsEnabled="{Binding IsAvailable}"
                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NewAssetCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{StaticResource Paper}" />
                  <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource Fog}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <ContentControl Content="{Binding Current}" Margin="16">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:AssetViewModel">
            <views:AssetView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Panel>
  </Grid>
</Window>
