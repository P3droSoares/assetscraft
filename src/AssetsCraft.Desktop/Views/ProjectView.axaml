<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AssetsCraft.Desktop.ViewModels"
             xmlns:views="using:AssetsCraft.Desktop.Views"
             xmlns:sprites="using:AssetsCraft.Core.Sprites"
             x:Class="AssetsCraft.Desktop.Views.ProjectView"
             x:DataType="vm:ProjectViewModel"
             DragDrop.AllowDrop="True">

  <Grid ColumnDefinitions="*,16,400">
    <!-- ======================= conversation ======================= -->
    <Border x:Name="ChatArea" Grid.Column="0" Classes="card" Padding="0" ClipToBounds="True">
      <DockPanel>
        <!-- status -->
        <Border DockPanel.Dock="Top" Classes="hairline-b" Background="{StaticResource Obsidian}" Padding="20,8"
                IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Arc Classes="spinner" />
            <TextBlock Classes="muted" FontSize="13" Text="{Binding Status}" />
          </StackPanel>
        </Border>

        <!-- composer -->
        <Border DockPanel.Dock="Bottom" Padding="16">
          <Border Classes="panel" CornerRadius="12" Padding="12,8,8,8">
            <DockPanel>
              <!-- files waiting to be sent: each one is inspiration or material used in the sprite -->
              <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PendingAttachments}" IsVisible="{Binding HasAttachments}"
                            Margin="0,4,0,6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PendingAttachment">
                    <Border Classes="attachment" Margin="0,0,8,8" ToolTip.Tip="{Binding Path}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="28" Height="28">
                          <Border CornerRadius="4" ClipToBounds="True" IsVisible="{Binding HasThumbnail}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border>
                          <Border Classes="badge" HorizontalAlignment="Center" IsVisible="{Binding !HasThumbnail}">
                            <TextBlock Classes="mono" FontSize="10" Text="{Binding Badge}" />
                          </Border>
                        </Panel>
                        <StackPanel VerticalAlignment="Center" MaxWidth="160">
                          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Mist}" />
                          <TextBlock Classes="mono faint" FontSize="10" Text="{Binding SizeText}" />
                        </StackPanel>
                        <ToggleButton Classes="use" IsChecked="{Binding UseAsMaterial}" Content="{Binding UseLabel}"
                                      VerticalAlignment="Center" IsVisible="{Binding CanBeMaterial}"
                                      ToolTip.Tip="Só inspiração: o Claude se baseia no estilo, paleta e poses. Usar no sprite: o arquivo entra de verdade (editar, recortar, animar, aproveitar a paleta)." />
                        <Button Classes="text" Content="✕" FontSize="10" Padding="4,2" VerticalAlignment="Center"
                                ToolTip.Tip="Remover"
                                Command="{Binding $parent[UserControl].((vm:ProjectViewModel)DataContext).RemoveAttachmentCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                  <Button Classes="primary" Content="Enviar" Command="{Binding SendCommand}" IsVisible="{Binding !IsBusy}" />
                  <Button Classes="stop" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="8" Height="8" CornerRadius="1" Background="{StaticResource Mist}" VerticalAlignment="Center" />
                      <TextBlock Text="Parar" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Classes="text" Click="OnAttach"
                          ToolTip.Tip="Imagens, sprites, vídeos ou PDFs. Também dá para arrastar para qualquer lugar desta tela.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="+" FontSize="15" Foreground="{StaticResource Fog}" Margin="0,-2,0,0" />
                      <TextBlock Text="Anexar" FontSize="12" Foreground="{StaticResource Fog}" />
                    </StackPanel>
                  </Button>
                  <Border Width="1" Height="14" Background="{StaticResource Graphite}" Margin="4,0" />
                  <!-- model picker -->
                  <Button x:Name="ModelButton" Classes="text" IsEnabled="{Binding !IsBusy}"
                          ToolTip.Tip="Modelo usado nesta etapa (troca sem perder o histórico)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding ModelLabel}" FontSize="12" Foreground="{StaticResource Fog}" />
                      <Path Width="8" Height="5" Stretch="Uniform" Stroke="{StaticResource Fog}" StrokeThickness="1.3"
                            Data="M0,0 L4,4 L8,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                      <Flyout Placement="TopEdgeAlignedLeft" FlyoutPresenterClasses="picker">
                        <StackPanel Spacing="2" Width="300">
                          <TextBlock Classes="label-strong" Text="Modelo" Margin="10,6,10,6" />
                          <ItemsControl ItemsSource="{Binding ModelChoices}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:ModelChoice">
                                <Button Classes="pick" Click="OnModelPicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2">
                                      <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Mist}" />
                                      <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Ash}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Path Grid.Column="1" Width="11" Height="8" Stretch="Uniform" Stroke="{StaticResource Paper}" StrokeThickness="1.5"
                                          Data="M0,4 L4,8 L11,0" VerticalAlignment="Center" Margin="10,0,2,0"
                                          IsVisible="{Binding IsSelected}" />
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                  <Border Width="1" Height="14" Background="{StaticResource Graphite}" Margin="4,0" />
                  <Border Classes="kbd"><TextBlock Text="↵" /></Border>
                  <TextBlock Classes="faint" FontSize="12" Text="enviar" VerticalAlignment="Center" />
                </StackPanel>
              </DockPanel>
              <TextBox x:Name="InputBox" Classes="composer" Text="{Binding Input}" AcceptsReturn="True" TextWrapping="Wrap"
                       MinHeight="56" MaxHeight="220" Watermark="{Binding ComposerHint}" />
            </DockPanel>
          </Border>
        </Border>

        <!-- messages -->
        <ScrollViewer x:Name="MessagesScroll">
          <StackPanel Margin="24,20,24,8" MaxWidth="900">
            <!-- empty state -->
            <StackPanel Spacing="14" Margin="0,24,0,0" IsVisible="{Binding IsEmpty}">
              <TextBlock Classes="heading" Text="{Binding EmptyTitle}" />
              <TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                         Text="{Binding EmptyText}" />
              <Border Classes="notice" HorizontalAlignment="Left" MaxWidth="560" IsVisible="{Binding HasGameStyle}"
                      ToolTip.Tip="Uma cópia dos PNGs do projeto fica em references/game-style. O jogo não é alterado. Para outro estilo, é só pedir.">
                <TextBlock FontSize="12" Foreground="{StaticResource Mist}" TextWrapping="Wrap" Text="{Binding GameStyleText}" />
              </Border>
              <TextBlock Classes="label-strong" Text="Ideias para começar" Margin="0,6,0,0" />
              <ItemsControl ItemsSource="{Binding SuggestionList}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Button Classes="chip" Margin="0,0,8,8" Content="{Binding}"
                            Command="{Binding $parent[UserControl].((vm:ProjectViewModel)DataContext).UseSuggestionCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Messages}">
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="vm:UserMessageViewModel">
                  <Border Classes="msg-user">
                    <StackPanel Spacing="8">
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource Paper}" LineHeight="22" />
                      <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SentAttachment">
                            <Border Classes="attachment small" Margin="0,0,6,4">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge"><TextBlock Classes="mono" FontSize="10" Text="{Binding Badge}" /></Border>
                                <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Mist}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>

                <DataTemplate DataType="vm:AssistantMessageViewModel">
                  <Border Classes="msg-assistant">
                    <StackPanel Spacing="2">
                      <SelectableTextBlock views:MarkdownText.Source="{Binding Text}" TextWrapping="Wrap" LineHeight="23" FontSize="14"
                                           Foreground="{StaticResource Mist}" />
                      <TextBlock Text="▍" Foreground="{StaticResource Fog}" IsVisible="{Binding IsStreaming}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>

                <DataTemplate DataType="vm:ToolMessageViewModel">
                  <Expander Classes="tool" Classes.err="{Binding IsError}">
                    <Expander.Header>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Panel Width="12">
                          <Arc Classes="spinner" IsVisible="{Binding IsPending}" />
                          <Ellipse Classes="dot" IsVisible="{Binding !IsPending}" />
                        </Panel>
                        <Border Classes="badge">
                          <TextBlock Classes="mono" FontSize="11" Text="{Binding ToolName}" />
                        </Border>
                        <TextBlock Classes="mono muted" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                   MaxWidth="600" VerticalAlignment="Center" />
                        <Border Classes="badge" IsVisible="{Binding IsError}">
                          <TextBlock Text="erro" />
                        </Border>
                      </StackPanel>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="320">
                      <SelectableTextBlock Classes="mono" Foreground="{StaticResource Fog}" Text="{Binding Details}" TextWrapping="Wrap" LineHeight="19" />
                    </ScrollViewer>
                  </Expander>
                </DataTemplate>

                <DataTemplate DataType="vm:NoticeMessageViewModel">
                  <Border Classes="msg-notice" Classes.error="{Binding IsError}">
                    <SelectableTextBlock Classes="faint" FontSize="12" views:MarkdownText.Source="{Binding Text}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,12" IsVisible="{Binding IsBusy}">
              <Arc Classes="spinner" />
              <TextBlock Classes="muted" FontSize="13" Text="Claude trabalhando…" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>


    <!-- ======================= side: result + next step ======================= -->
    <DockPanel Grid.Column="2">
      <!-- next step, always visible: the one thing to do when the version looks good -->
      <Border DockPanel.Dock="Bottom" Classes="cta" Margin="0,12,0,0" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="8">
          <Button Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Content="{Binding PrimaryActionLabel}" Command="{Binding PrimaryActionCommand}" IsEnabled="{Binding !IsBusy}" />
          <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding PrimaryActionHint}" />
          <Button Classes="text" HorizontalAlignment="Center" FontSize="12" Content="{Binding SecondarySendLabel}"
                  Command="{Binding SendToGameCommand}" IsVisible="{Binding IsSprite}"
                  ToolTip.Tip="{Binding SendTarget, StringFormat='Copia o PNG desta versão para {0}'}" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Ellipse Classes="sent-dot" IsVisible="{Binding IsSentToGame}" />
            <TextBlock Classes="faint" FontSize="11" TextWrapping="Wrap" Text="{Binding SentInfo}" />
          </StackPanel>
          <Button Classes="text" HorizontalAlignment="Center" FontSize="12" Content="Remover do jogo"
                  Command="{Binding RemoveFromGameCommand}" IsVisible="{Binding IsSentToGame}"
                  ToolTip.Tip="Desfaz o envio: apaga o PNG do projeto do jogo e devolve o arquivo que estava lá antes, se havia um" />
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="SideScroll">
        <StackPanel Spacing="12">
          <!-- viewer -->
          <Border Classes="card" Padding="14">
            <StackPanel Spacing="10">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelection}">
                  <Button Classes="text" Click="OnPreview" ToolTip.Tip="Ver em tela grande, quadro a quadro">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource Mist}" StrokeThickness="1.4"
                            Data="M0,4 L0,0 L4,0 M6,0 L10,0 L10,4 M10,6 L10,10 L6,10 M4,10 L0,10 L0,6" VerticalAlignment="Center" />
                      <TextBlock Text="Ampliar" FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Classes="text" Padding="8,6" ToolTip.Tip="Mais opções desta versão">
                    <StackPanel Orientation="Horizontal" Spacing="2.5">
                      <Ellipse Width="3" Height="3" Fill="{StaticResource Fog}" />
                      <Ellipse Width="3" Height="3" Fill="{StaticResource Fog}" />
                      <Ellipse Width="3" Height="3" Fill="{StaticResource Fog}" />
                    </StackPanel>
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Exportar PNG + JSON + GIFs…" Click="OnExport"
                                  ToolTip.Tip="Formato Aseprite: aceito por Godot, Phaser, Unity, LÖVE e outros" />
                        <MenuItem Header="Salvar só o PNG…" Click="OnSavePngClick" />
                        <MenuItem Header="Abrir no visualizador do sistema" Command="{Binding OpenSpriteExternallyCommand}" />
                        <MenuItem Header="Atualizar" Command="{Binding RefreshFilesCommand}" />
                        <Separator />
                        <MenuItem Header="Remover do jogo…" Command="{Binding RemoveFromGameCommand}" IsVisible="{Binding IsSentToGame}" />
                        <MenuItem Header="Excluir esta versão…" Click="OnDeleteSpriteClick" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Classes="section" Text="{Binding StepTitle}" />
                  <Border Classes="badge in-use" IsVisible="{Binding HasSelection}">
                    <TextBlock Classes="mono" FontSize="11" Text="{Binding SelectedVersionLabel}" />
                  </Border>
                </StackPanel>
              </DockPanel>

              <!-- nothing yet: say where the result will show up -->
              <Border Classes="panel" Padding="18,40" IsVisible="{Binding HasNoSprites}" BorderBrush="{StaticResource Smoke}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <TextBlock FontSize="13" Text="A primeira versão aparece aqui" Foreground="{StaticResource Mist}" HorizontalAlignment="Center" />
                  <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                             Text="Descreva no chat ao lado. O sprite toca aqui em pixels nítidos, sem borrar." />
                </StackPanel>
              </Border>

              <StackPanel Spacing="10" IsVisible="{Binding HasSelection}">
                <Border CornerRadius="6" ClipToBounds="True" BorderBrush="{StaticResource Graphite}" BorderThickness="1">
                  <views:SpriteCanvas x:Name="MainCanvas" Height="280"
                                      Sheet="{Binding Sheet}" Animation="{Binding SelectedAnimation}"
                                      IsPlaying="{Binding IsPlaying}" Position="{Binding Position}"
                                      Zoom="{Binding Zoom}" Speed="{Binding Speed}" Backdrop="{Binding Backdrop.Id}"
                                      ShowSheet="{Binding ShowSheet}" ShowGrid="{Binding ShowGrid}" />
                </Border>

                <!-- transport + view -->
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <ComboBox ItemsSource="{Binding ZoomList}" SelectedItem="{Binding Zoom}" FontSize="12" Width="92"
                              ToolTip.Tip="Zoom">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32"><TextBlock Text="{Binding Converter={x:Static views:Texts.ZoomLabel}}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Padding="9,6" ToolTip.Tip="Fundo, velocidade, folha inteira e grade">
                      <TextBlock Text="Exibir" FontSize="12" />
                      <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="picker">
                          <StackPanel Spacing="10" Width="220" Margin="8">
                            <StackPanel Spacing="4">
                              <TextBlock Classes="faint" FontSize="11" Text="Fundo" />
                              <ComboBox ItemsSource="{Binding BackdropList}" SelectedItem="{Binding Backdrop}" HorizontalAlignment="Stretch" FontSize="12">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:BackdropChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="4">
                              <TextBlock Classes="faint" FontSize="11" Text="Velocidade" />
                              <ComboBox ItemsSource="{Binding SpeedList}" SelectedItem="{Binding Speed}" HorizontalAlignment="Stretch" FontSize="12">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="x:Double"><TextBlock Text="{Binding Converter={x:Static views:Texts.SpeedLabel}}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                            <CheckBox Content="Folha inteira" IsChecked="{Binding ShowSheet}" FontSize="12"
                                      ToolTip.Tip="Mostra a imagem completa com o limite de cada quadro" />
                            <CheckBox Content="Grade de pixels" IsChecked="{Binding ShowGrid}" FontSize="12"
                                      ToolTip.Tip="Linhas entre os pixels quando o zoom é grande" />
                            <TextBlock Classes="mono faint" FontSize="10" TextWrapping="Wrap" Text="{Binding SheetSummary}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="ms wide" Content="◀" Command="{Binding StepFrameCommand}" CommandParameter="-1" ToolTip.Tip="Quadro anterior" />
                    <Button Classes="ms wide" Command="{Binding TogglePlayCommand}" ToolTip.Tip="{Binding PlayLabel}">
                      <Panel>
                        <Path Width="7" Height="8" Stretch="Uniform" Fill="{StaticResource Mist}" Data="M0,0 L7,4 L0,8 Z" IsVisible="{Binding !IsPlaying}" />
                        <Path Width="7" Height="8" Stretch="Uniform" Fill="{StaticResource Mist}" Data="M0,0 H2.5 V8 H0 Z M4.5,0 H7 V8 H4.5 Z" IsVisible="{Binding IsPlaying}" />
                      </Panel>
                    </Button>
                    <Button Classes="ms wide" Content="▶" Command="{Binding StepFrameCommand}" CommandParameter="1" ToolTip.Tip="Próximo quadro" />
                    <TextBlock Classes="mono faint" FontSize="11" Text="{Binding FrameLabel}" VerticalAlignment="Center" Margin="6,0,0,0" />
                  </StackPanel>
                </DockPanel>

                <!-- animations of this version (only when there is something to choose) -->
                <StackPanel Spacing="4" IsVisible="{Binding HasManyAnimations}">
                  <TextBlock Classes="label-strong" Text="Animações" />
                  <ListBox Classes="chips" ItemsSource="{Binding Animations}" SelectedItem="{Binding SelectedAnimation}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="sprites:SpriteAnimation">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Name}" FontSize="12" />
                          <TextBlock Classes="mono faint" FontSize="10" Text="{Binding Count}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Classes="faint" FontSize="11" Text="{Binding AnimationInfo}" />
                </StackPanel>

                <!-- versions: newest first; pick one to compare, the next step uses the one selected -->
                <StackPanel Spacing="4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Classes="faint" FontSize="11" Text="peça ajustes no chat para criar outra" VerticalAlignment="Center" />
                    <TextBlock Classes="label-strong" Text="Versões" />
                  </DockPanel>
                  <ListBox Classes="chips" ItemsSource="{Binding Sprites}" SelectedItem="{Binding SelectedSprite}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:MediaFile">
                        <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Info}">
                          <Ellipse Classes="sent-dot" IsVisible="{Binding IsSent}" ToolTip.Tip="Esta versão está no projeto do jogo" />
                          <TextBlock Classes="mono" FontSize="12" Text="{Binding VersionLabel}" />
                          <TextBlock Classes="faint" FontSize="10" Text="nova" VerticalAlignment="Center" IsVisible="{Binding IsLatest}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding ExportError}"
                     IsVisible="{Binding ExportError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border Classes="notice" IsVisible="{Binding ExportInfo, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock FontSize="12" Foreground="{StaticResource Mist}" TextWrapping="Wrap" Text="{Binding ExportInfo}" />
          </Border>

          <!-- files: materials used in the sprite + GIFs, out of the way until needed -->
          <Expander Classes="tool" IsVisible="{Binding HasFiles}" HorizontalAlignment="Stretch">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="section" Text="Arquivos" />
                <Border Classes="badge"><TextBlock Classes="mono" Text="{Binding FilesCount}" /></Border>
              </StackPanel>
            </Expander.Header>
            <StackPanel Spacing="10">
              <StackPanel Spacing="4" IsVisible="{Binding !HasNoAssets}">
                <TextBlock Classes="label-strong" Text="Usados no sprite" />
                <ItemsControl ItemsSource="{Binding Assets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaFile">
                      <DockPanel Margin="2,3">
                        <Button DockPanel.Dock="Right" Classes="text" Content="✕" FontSize="10" Padding="5,2" Margin="6,0,0,0"
                                ToolTip.Tip="Remover deste asset" Click="OnDeleteAssetClick" />
                        <TextBlock DockPanel.Dock="Right" Classes="mono faint" FontSize="11" Text="{Binding Info}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Spacing="4" IsVisible="{Binding HasGifs}">
                <TextBlock Classes="label-strong" Text="{Binding SelectedVersionLabel, StringFormat='GIFs da {0}'}" />
                <ItemsControl ItemsSource="{Binding Gifs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaFile">
                      <DockPanel Margin="2,3">
                        <Button DockPanel.Dock="Right" Content="Salvar…" FontSize="11" Padding="8,3" Click="OnSaveGifClick" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Classes="text" Content="Abrir" FontSize="11" Padding="6,3"
                                Command="{Binding $parent[UserControl].((vm:ProjectViewModel)DataContext).OpenFileCommand}" CommandParameter="{Binding}" />
                        <TextBlock DockPanel.Dock="Right" Classes="mono faint" FontSize="11" Text="{Binding Info}" VerticalAlignment="Center" Margin="8,0" />
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
