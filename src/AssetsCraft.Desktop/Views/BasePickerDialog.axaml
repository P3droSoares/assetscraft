<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetsCraft.Desktop.ViewModels"
        xmlns:views="using:AssetsCraft.Desktop.Views"
        x:Class="AssetsCraft.Desktop.Views.BasePickerDialog"
        Width="620" Height="440" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Carbon}" Title="Nova animação">
  <Border BorderBrush="{StaticResource Graphite}" BorderThickness="0,1,0,0" Padding="24">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,14">
        <TextBlock Classes="title" Text="Qual sprite vamos animar?" />
        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                   Text="A versão mais recente do sprite vira a base fixa (idle); as animações são desenhadas a partir dela." />
      </StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button Content="Cancelar" Click="OnCancel" IsCancel="True" />
        <Button x:Name="ConfirmButton" Classes="solid" Content="Animar" Click="OnConfirm" IsEnabled="False" />
      </StackPanel>
      <Grid ColumnDefinitions="*,16,220">
        <ListBox x:Name="List" Classes="nav" SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BaseCandidate">
              <StackPanel Spacing="1">
                <TextBlock Text="{Binding Title}" FontSize="13" />
                <TextBlock Classes="mono faint" FontSize="10" Text="{Binding Info}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Column="2" CornerRadius="6" ClipToBounds="True" BorderBrush="{StaticResource Graphite}" BorderThickness="1">
          <views:SpriteCanvas x:Name="Preview" />
        </Border>
      </Grid>
    </DockPanel>
  </Border>
</Window>
