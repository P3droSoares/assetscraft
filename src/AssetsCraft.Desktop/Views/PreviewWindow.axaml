<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AssetsCraft.Desktop.Views"
        x:Class="AssetsCraft.Desktop.Views.PreviewWindow"
        Title="Ampliar"
        Width="1100" Height="820" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20,16,20,20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Border Classes="kbd"><TextBlock Text="Espaço" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="play/pausa" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="← →" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="quadro" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="↑ ↓" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="animação" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="+ −" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="zoom" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="F" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="folha" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="G" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="grade" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="B" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="fundo" VerticalAlignment="Center" Margin="0,0,8,0" />
        <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
        <TextBlock Classes="faint" FontSize="12" Text="fechar" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Classes="title" TextTrimming="CharacterEllipsis" MaxWidth="360" />
        <Border Classes="badge"><TextBlock x:Name="AnimText" /></Border>
        <TextBlock x:Name="InfoText" Classes="mono faint" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource Graphite}" BorderThickness="1">
      <views:SpriteCanvas x:Name="Canvas" />
    </Border>
  </DockPanel>
</Window>
