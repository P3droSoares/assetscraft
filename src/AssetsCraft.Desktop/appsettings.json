{
  "AssetsCraft": {
    "WorkspacesRoot": "",
    "TemplatePath": "template/workspace",
    "AutoInstallDependencies": true,
    "Claude": {
      "ExecutablePath": "claude",
      "Model": null,
      "PermissionMode": "acceptEdits",
      "SettingSources": "project,local",
      "AllowedTools": [
        "Read",
        "Write",
        "Edit",
        "MultiEdit",
        "Glob",
        "Grep",
        "TodoWrite",
        "Bash(node tools/sprite.mjs:*)",
        "Bash(npm run sprite:*)",
        "Bash(ffmpeg:*)",
        "Bash(ffprobe:*)",
        "Bash(ls:*)",
        "Bash(mkdir:*)",
        "Bash(cp:*)",
        "Bash(mv:*)",
        "Bash(cat:*)",
        "Bash(head:*)",
        "Bash(file:*)"
      ],
      "DisallowedTools": [
        "Bash(npm install:*)",
        "Bash(npm i:*)",
        "Bash(npm uninstall:*)",
        "Bash(npm update:*)",
        "Bash(npm ci:*)",
        "Bash(yarn:*)",
        "Bash(pnpm:*)",
        "Edit(node_modules/**)",
        "Write(node_modules/**)",
        "Edit(tools/**)",
        "Write(tools/**)"
      ],
      "AppendSystemPrompt": "Você está rodando dentro do AssetsCraft, uma interface para criar sprites e sprite sheets para jogos. Responda em português do Brasil. O usuário não vê o terminal; siga o CLAUDE.md do workspace.",
      "ExtraArgs": []
    }
  }
}
