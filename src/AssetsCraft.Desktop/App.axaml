<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AssetsCraft.Desktop.App"
             RequestedThemeVariant="Dark">

  <!-- Fluent theme resources remapped to the Linear-style tokens (see Styles.axaml) -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#D0D6E0</Color>
          <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
          <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
          <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

          <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#D0D6E0" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#62666D" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#23252A" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#383B3F" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#383B3F" />
          <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#23252A" />

          <SolidColorBrush x:Key="TextControlBackground" Color="#05FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#05FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#383B3F" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D0D6E0" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#D0D6E0" />
          <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#D0D6E0" />
          <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#62666D" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#62666D" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#62666D" />
          <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#556366F1" />
          <Thickness x:Key="TextControlBorderThemeThickness">1</Thickness>
          <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>

          <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#05FFFFFF" />
          <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#23252A" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="#383B3F" />
          <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="#383B3F" />
          <SolidColorBrush x:Key="ExpanderHeaderForeground" Color="#D0D6E0" />
          <SolidColorBrush x:Key="ExpanderHeaderForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ExpanderHeaderForegroundPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ExpanderChevronForeground" Color="#62666D" />
          <SolidColorBrush x:Key="ExpanderChevronForegroundPointerOver" Color="#D0D6E0" />
          <SolidColorBrush x:Key="ExpanderChevronBackground" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderChevronBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ExpanderContentBackground" Color="#161718" />
          <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#23252A" />
          <x:Double x:Key="ExpanderMinHeight">32</x:Double>

          <SolidColorBrush x:Key="SliderTrackFill" Color="#23252A" />
          <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#383B3F" />
          <SolidColorBrush x:Key="SliderTrackValueFill" Color="#D0D6E0" />
          <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF" />

          <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#383B3F" />
          <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#62666D" />

          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#161718" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#23252A" />
          <Thickness x:Key="MenuFlyoutPresenterBorderThemeThickness">1</Thickness>
          <SolidColorBrush x:Key="MenuFlyoutItemBackground" Color="Transparent" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#D0D6E0" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#62666D" />
          <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#23252A" />
          <SolidColorBrush x:Key="ComboBoxBackground" Color="#05FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#08FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#383B3F" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#D0D6E0" />
          <SolidColorBrush x:Key="ComboBoxForeground" Color="#D0D6E0" />
          <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#8A8F98" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#161718" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#23252A" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#D0D6E0" />
          <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxItemPillFillSelected" Color="#D0D6E0" />
          <SolidColorBrush x:Key="CheckBoxForegroundUnchecked" Color="#D0D6E0" />
          <SolidColorBrush x:Key="CheckBoxForegroundChecked" Color="#D0D6E0" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#383B3F" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#D0D6E0" />
          <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#D0D6E0" />
          <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#08090A" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#161718" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#383B3F" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#D0D6E0" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AssetsCraft/Styles.axaml" />
  </Application.Styles>
</Application>
